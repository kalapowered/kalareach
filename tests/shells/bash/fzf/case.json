{
  "id": "bash-fzf",
  "shell": "bash",
  "stack": "fzf",
  "title": "fzf's widgets on the packaged Bash, which rebind Readline keys through a macro",
  "supported": true,
  "requires": [
    "fzf",
    "fzf-shell"
  ],
  "order": [
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-binding",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_writes_buffer",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "escape_then_gesture_is_native",
    "takeover_under_the_stack"
  ],
  "plugin": {
    "probe": "echo kr-plugin=$(type -t __fzf_select__)",
    "marker": "kr-plugin=function"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74",
    "KR-REQ-07.78",
    "KR-REQ-07.79",
    "KR-REQ-07.83"
  ],
  "home": [
    {
      "file": "bashrc",
      "path": ".bashrc"
    }
  ]
}
