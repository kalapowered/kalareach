{
  "id": "bash-starship",
  "shell": "bash",
  "stack": "starship",
  "title": "starship on the packaged Bash, with its prompt command and its own trap",
  "supported": true,
  "requires": [
    "starship"
  ],
  "order": [
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-binding",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "escape_then_gesture_is_native",
    "launch_deadline_installs_nothing"
  ],
  "plugin": {
    "probe": "echo kr-plugin=${STARSHIP_SESSION_KEY:+on}",
    "marker": "kr-plugin=on",
    "operation": "echo kr-plugin-$([ -n \"$STARSHIP_START_TIME\" ] && echo set || echo unset)",
    "operation_marker": "kr-plugin-set"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74",
    "KR-REQ-07.78",
    "KR-REQ-07.79",
    "KR-REQ-07.83"
  ],
  "home": [
    {
      "file": "bashrc",
      "path": ".bashrc"
    },
    {
      "file": "starship.toml",
      "path": ".config/starship.toml"
    }
  ]
}
