{
  "id": "powershell-starship",
  "shell": "powershell",
  "stack": "starship",
  "title": "starship on the qualified PSReadLine, which replaces the prompt function",
  "supported": true,
  "notes": "The Windows leg of this package, where the endpoint is a named pipe and the gesture is the configured chord rather than the terminal's own end-of-file character, is qualified on Windows. What is driven here is the gesture this editor reads on a Unix terminal.",
  "requires": [
    "starship"
  ],
  "order": [
    "all-hosts",
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-binding",
  "checks": [
    "identity",
    "profile_order",
    "profile_once",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches"
  ],
  "plugin": {
    "probe": "\"kr-plugin=$(if ($env:STARSHIP_SESSION_KEY) {'on'} else {'off'})\"",
    "marker": "kr-plugin=on",
    "operation": "\"kr-plugin-$(if ($env:STARSHIP_SHELL) {'set'} else {'unset'})\"",
    "operation_marker": "kr-plugin-set"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74",
    "KR-REQ-07.78",
    "KR-REQ-07.79",
    "KR-REQ-07.83"
  ],
  "home": [
    {
      "file": "profile.ps1",
      "path": ".config/powershell/profile.ps1"
    },
    {
      "file": "host-profile.ps1",
      "path": ".config/powershell/Microsoft.PowerShell_profile.ps1"
    },
    {
      "file": "starship.toml",
      "path": ".config/starship.toml"
    }
  ]
}
