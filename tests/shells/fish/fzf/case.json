{
  "id": "fish-fzf",
  "shell": "fish",
  "stack": "fzf",
  "title": "fzf's key bindings on the packaged fish, which claim keys in every bind mode",
  "supported": true,
  "requires": [
    "fzf",
    "fzf-shell"
  ],
  "order": [
    "conf-d",
    "stack",
    "user-top",
    "user-bottom"
  ],
  "binding": "kr-user-binding",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings"
  ],
  "plugin": {
    "probe": "echo kr-plugin=(functions -q fzf-file-widget; and echo on; or echo off)",
    "marker": "kr-plugin=on"
  },
  "covers": [
    "KR-REQ-07.87"
  ],
  "home": [
    {
      "file": "order.fish",
      "path": ".config/fish/conf.d/00-kr-order.fish"
    },
    {
      "file": "fzf.fish",
      "path": ".config/fish/conf.d/10-fzf.fish"
    },
    {
      "file": "config.fish",
      "path": ".config/fish/config.fish"
    }
  ]
}
