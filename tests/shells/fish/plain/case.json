{
  "id": "fish-plain",
  "shell": "fish",
  "stack": "none",
  "title": "the packaged fish with the person's own configuration and nothing else",
  "supported": true,
  "requires": [],
  "order": [
    "conf-d",
    "user-top",
    "user-bottom"
  ],
  "binding": "kr-user-binding",
  "checks": [
    "identity",
    "profile_order",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "every_exclusion_accounted_for",
    "unattributable_gesture_hints",
    "gesture_follows_the_line_discipline"
  ],
  "covers": [
    "KR-REQ-07.85",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74"
  ],
  "home": [
    {
      "file": "order.fish",
      "path": ".config/fish/conf.d/00-kr-order.fish"
    },
    {
      "file": "config.fish",
      "path": ".config/fish/config.fish"
    }
  ]
}
