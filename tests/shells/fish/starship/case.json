{
  "id": "fish-starship",
  "shell": "fish",
  "stack": "starship",
  "title": "starship on the packaged fish, through conf.d and the prompt function it installs",
  "supported": true,
  "requires": [
    "starship"
  ],
  "order": [
    "conf-d",
    "stack",
    "user-top",
    "user-bottom"
  ],
  "binding": "kr-user-binding",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "launch_deadline_installs_nothing"
  ],
  "plugin": {
    "probe": "echo kr-plugin=(set -q STARSHIP_SESSION_KEY; and echo on; or echo off)",
    "marker": "kr-plugin=on"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74",
    "KR-REQ-07.78",
    "KR-REQ-07.79",
    "KR-REQ-07.83"
  ],
  "home": [
    {
      "file": "order.fish",
      "path": ".config/fish/conf.d/00-kr-order.fish"
    },
    {
      "file": "starship.fish",
      "path": ".config/fish/conf.d/10-starship.fish"
    },
    {
      "file": "config.fish",
      "path": ".config/fish/config.fish"
    },
    {
      "file": "starship.toml",
      "path": ".config/starship.toml"
    }
  ]
}
