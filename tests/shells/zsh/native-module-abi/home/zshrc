print -r -- user-top >> "$KR_TEST_ORDER"
# What the shell already holds before anything of the person's runs.
zmodload -L > "$HOME/preloaded" 2>/dev/null

PROMPT='KR> '
setopt no_beep
unsetopt zle_rprompt_indent 2>/dev/null
HISTFILE=
typeset -g KR_TEST_USER_CONFIGURATION=1

# Native modules of the person's own, built against the shell's headers and ahead of the shell's
# own module path. Which ones this home loads is the test's choice.
module_path=("$HOME/modules" $module_path)
# A module of the editor binds to the editor's own variables when it loads, so the editor is loaded
# first, as a person's startup file does before it loads one.
zmodload zsh/zle
for module in ${=KR_TEST_USER_MODULES}; do
  if zmodload "$module" 2>>"$HOME/module-error"; then
    print -r -- kr-module-loaded >> "$KR_TEST_ORDER"
  else
    print -r -- kr-module-refused >> "$KR_TEST_ORDER"
  fi
done

# A configuration that loads a module and then removes its file, or puts another file in its place
# as an update does: the shell still runs the module it loaded, whatever the name now finds.
if [[ -n "$KR_TEST_REMOVE_AFTER_LOAD" ]]; then
  zmodload -F zsh/files b:rm && rm -f -- "$HOME/modules/$KR_TEST_REMOVE_AFTER_LOAD.so"
fi
if [[ -n "$KR_TEST_REPLACE_AFTER_LOAD" ]]; then
  zmodload -F zsh/files b:mv && mv -f -- "$HOME/replacement.so" "$HOME/modules/$KR_TEST_REPLACE_AFTER_LOAD.so"
fi

print -r -- user-bottom >> "$KR_TEST_ORDER"
