print -r -- user-top >> "$KR_TEST_ORDER"
# What the shell already holds before anything of the person's runs.
zmodload -L > "$HOME/preloaded" 2>/dev/null

PROMPT='KR> '
setopt no_beep
unsetopt zle_rprompt_indent 2>/dev/null
HISTFILE=
typeset -g KR_TEST_USER_CONFIGURATION=1

# Native modules of the person's own, built against the shell's headers and ahead of the shell's
# own module path. Which ones this home loads is the test's choice.
module_path=("$HOME/modules" $module_path)
for module in ${=KR_TEST_USER_MODULES}; do
  if zmodload "$module" 2>>"$HOME/module-error"; then
    print -r -- kr-module-loaded >> "$KR_TEST_ORDER"
  else
    print -r -- kr-module-refused >> "$KR_TEST_ORDER"
  fi
done

print -r -- user-bottom >> "$KR_TEST_ORDER"
