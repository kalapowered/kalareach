{
  "id": "zsh-powerlevel10k",
  "shell": "zsh",
  "stack": "powerlevel10k",
  "title": "Powerlevel10k with its instant prompt, which draws a reader before the startup file finishes",
  "supported": true,
  "requires": [
    "powerlevel10k"
  ],
  "order": [
    "user-top",
    "stack",
    "user-bottom"
  ],
  "warm_order": [
    "instant-prompt",
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-widget",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "escape_then_gesture_is_native",
    "launch_deadline_installs_nothing",
    "instant_prompt"
  ],
  "plugin": {
    "probe": "echo kr-plugin=$(( $+functions[p10k] ))",
    "marker": "kr-plugin=1"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74",
    "KR-REQ-07.78",
    "KR-REQ-07.79",
    "KR-REQ-07.83"
  ],
  "home": [
    {
      "file": "zshrc",
      "path": ".zshrc"
    },
    {
      "file": "p10k.zsh",
      "path": ".p10k.zsh"
    }
  ]
}
