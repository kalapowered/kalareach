{
  "id": "zsh-starship",
  "shell": "zsh",
  "stack": "starship",
  "title": "starship, a prompt that runs a program at every prompt and installs its own hooks",
  "supported": true,
  "requires": ["starship"],
  "order": ["user-top", "stack", "user-bottom"],
  "binding": "kr-user-widget",
  "checks": ["identity", "profile_order", "user_bindings", "plugin_buffer"],
  "covers": ["KR-REQ-07.87"],
  "home": [
    { "file": "zshrc", "path": ".zshrc" },
    { "file": "starship.toml", "path": ".config/starship.toml" }
  ]
}
