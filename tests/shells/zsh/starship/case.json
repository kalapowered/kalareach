{
  "id": "zsh-starship",
  "shell": "zsh",
  "stack": "starship",
  "title": "starship, a prompt that runs a program at every prompt and installs its own hooks",
  "supported": true,
  "requires": [
    "starship"
  ],
  "order": [
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-widget",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "escape_then_gesture_is_native"
  ],
  "plugin": {
    "probe": "echo kr-plugin=${STARSHIP_SESSION_KEY:+on}",
    "marker": "kr-plugin=on",
    "operation": "echo kr-plugin-$([ -n \"$STARSHIP_START_TIME\" ] && echo set || echo unset)",
    "operation_marker": "kr-plugin-set"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74"
  ],
  "home": [
    {
      "file": "zshrc",
      "path": ".zshrc"
    },
    {
      "file": "starship.toml",
      "path": ".config/starship.toml"
    }
  ]
}
