{
  "id": "zsh-atuin",
  "shell": "zsh",
  "stack": "atuin",
  "title": "atuin, which replaces the history search and adds a pre-execution hook",
  "supported": true,
  "notes": "This customisation takes the key the reader's own search is on and opens a reader of its own there, so the excluded states this corpus drives through that key are not states of the managed reader in this case. They are driven on the same shell in its plain and distribution cases.",
  "requires": [
    "atuin"
  ],
  "order": [
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-widget",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "escape_then_gesture_is_native"
  ],
  "plugin": {
    "probe": "echo kr-atuin-stored",
    "marker": "kr-atuin-stored",
    "operation": "echo kr-plugin=$(\"$KR_STACK_ATUIN/atuin\" search --cmd-only --limit 1 --search-mode prefix -- 'echo kr-atuin-stored')",
    "operation_marker": "kr-plugin=echo kr-atuin-stored"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74"
  ],
  "home": [
    {
      "file": "zshrc",
      "path": ".zshrc"
    },
    {
      "file": "config.toml",
      "path": ".config/atuin/config.toml"
    }
  ]
}
