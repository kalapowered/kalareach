print -r -- user-top >> "$KR_TEST_ORDER"

PROMPT='KR> '
setopt no_beep
unsetopt zle_rprompt_indent 2>/dev/null
HISTFILE=
# This person deletes with the key rather than listing what completes: a listing of every command
# on the machine is not what they want from it, and a question about one is a reader waiting for an
# answer. The integration decides before the binding runs, so what the key is bound to is theirs.
bindkey '^D' delete-char
typeset -g KR_TEST_USER_CONFIGURATION=1

# These widgets bind Ctrl-T, Ctrl-R and Alt-C, and each runs a program inside the reader.
path=("$KR_STACK_FZF" $path)
# One candidate, so what the widget puts in the line is the one it was given.
export FZF_CTRL_T_COMMAND='printf "kr-fzf-choice\n"'
export FZF_DEFAULT_OPTS="--no-mouse --height=10"
source "$KR_STACK_FZF_SHELL/shell/completion.zsh"
source "$KR_STACK_FZF_SHELL/shell/key-bindings.zsh"
print -r -- stack >> "$KR_TEST_ORDER"

kr-user-widget() { BUFFER='kr-user-binding-ran'; CURSOR=$#BUFFER }
zle -N kr-user-widget
bindkey '^[q' kr-user-widget

print -r -- user-bottom >> "$KR_TEST_ORDER"
