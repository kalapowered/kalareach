# This plugin's own instructions put it at the end of the startup file, after everything that
# binds a key, because it wraps every widget it finds. The integration's marked entry is therefore
# before it, and the end-of-file decision this qualification drives is behind that wrapping.
print -r -- user-top >> "$KR_TEST_ORDER"

PROMPT='KR> '
setopt no_beep
unsetopt zle_rprompt_indent 2>/dev/null
HISTFILE=
typeset -g KR_TEST_USER_CONFIGURATION=1

kr-user-widget() { BUFFER='kr-user-binding-ran'; CURSOR=$#BUFFER }
zle -N kr-user-widget
bindkey '^[q' kr-user-widget

print -r -- user-bottom >> "$KR_TEST_ORDER"
# {kalareach-entry}

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
source "$KR_STACK_ZSH_SYNTAX_HIGHLIGHTING/zsh-syntax-highlighting.zsh"
print -r -- stack >> "$KR_TEST_ORDER"
