{
  "id": "zsh-oh-my-zsh",
  "shell": "zsh",
  "stack": "oh-my-zsh",
  "title": "oh-my-zsh with plugins, which rebinds keys and installs its own line-init hooks",
  "supported": true,
  "requires": [
    "oh-my-zsh"
  ],
  "order": [
    "user-top",
    "stack",
    "user-bottom"
  ],
  "binding": "kr-user-widget",
  "checks": [
    "identity",
    "profile_order",
    "plugin_active",
    "plugin_buffer",
    "user_bindings",
    "gesture_detaches",
    "gesture_is_native_outside_the_condition",
    "escape_then_gesture_is_native"
  ],
  "plugin": {
    "probe": "echo kr-plugin=$(( $+functions[omz] ))",
    "marker": "kr-plugin=1"
  },
  "covers": [
    "KR-REQ-07.87",
    "KR-REQ-07.72",
    "KR-REQ-07.73",
    "KR-REQ-07.74"
  ],
  "home": [
    {
      "file": "zshrc",
      "path": ".zshrc"
    }
  ]
}
