                    "op": "binding",
                    "state": "native_only_volatile"
                  }
                },
                {
                  "op": "capability",
                  "capability": "approval.respond",
                  "state": "qualified_available"
                }
              ]
            },
            "disabled_reason": "This host cannot answer Codex's approvals right now; answer in the terminal"
          },
          {
            "id": "decline-stop",
            "revision": "1",
            "label": "Decline and stop",
            "icon": "stop",
            "accessible_description": "Decline it and stop the turn",
            "action_id": "approval.answer",
            "parameters": {
              "parameters": [
                {
                  "name": "decision",
                  "kind": {
                    "type": "choice",
                    "choices": [
                      {
                        "id": "decline-and-stop",
                        "label": "Decline and stop"
                      }
                    ]
                  },
                  "label": "Decision",
                  "required": true
                }
              ]
            },
            "priority": "destructive",
            "visible_when": {
              "op": "all",
              "terms": [
                {
                  "op": "grant",
                  "right": "agent.approval.respond"
                },
                {
