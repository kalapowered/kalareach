{
  "id": "KR-ACC-030",
  "description": "The no-escape policy for names resolved beneath an authorised directory, and for the objects those names reach. Every case applies on every platform unless it names the platforms it needs; a case that needs an object the running platform cannot create is reported as not exercised rather than passed.",
  "refusals": {
    "ok": "the name is accepted and the object is opened",
    "empty": "the name is empty",
    "not_relative": "the name is absolute, names a drive or carries a stream separator",
    "parent_segment": "the name contains a parent segment",
    "current_segment": "the name contains a current-directory segment",
    "empty_component": "the name contains an empty component",
    "forbidden_byte": "the name contains a byte a filename cannot carry, or one a platform would rewrite",
    "reserved_name": "a component names a device rather than a file",
    "too_long": "the name or a component exceeds its bound",
    "link": "a component is a symbolic link or a reparse point, and resolution follows neither",
    "wrong_kind": "the opened object is not the kind the policy permits",
    "not_found": "the name does not exist beneath the authorised directory"
  },
