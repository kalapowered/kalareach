  "capabilities": [
    {
      "capability": "metadata.match",
      "reason": "Recognise Qoder CLI from its own installation directory, and from the executable names it installs, as a guess"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Show what the Qoder CLI session is doing and the controls for its turn"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read the turn and tool updates the selected agent-protocol execution reports"
    },
    {
      "capability": "upstream.action",
      "reason": "Ask Qoder CLI to stop the turn it is running when you press Stop"
    },
    {
      "capability": "command_integration.launch",
      "reason": "Start Qoder CLI in KalaReach sessions with the settings that register the KalaReach forwarder as its hooks"
    }
  ],
  "actions": [
    {
      "id": "turn.cancel",
      "label": "Stop the turn",
      "effect": "upstream.cancel",
      "implementation": {
        "type": "upstream_cancel"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Cancel the turn the bound Qoder CLI execution is running, which ends it as interrupted",
      "confirmation_required": false
    },
    {
      "id": "session.refresh",
      "label": "Refresh",
      "effect": "observe",
      "implementation": {
        "type": "presentation"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Draw this package's document again from the session state the host already holds",
      "confirmation_required": false
    }
  ],
  "attachments": null,
  "native_bridge": null,
  "command_integration": {
    "command": "qodercli",
    "flags": [
      "--settings",
      "{\"hooks\":{\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{kr_hook}\",\"args\":[\"qoder-cli\",\"hook\"],\"timeout\":5}]}],\"SessionEnd\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{kr_hook}\",\"args\":[\"qoder-cli\",\"hook\"],\"timeout\":1}]}],\"PostToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{kr_hook}\",\"args\":[\"qoder-cli\",\"hook\"],\"timeout\":5}]}],\"PostToolUseFailure\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{kr_hook}\",\"args\":[\"qoder-cli\",\"hook\"],\"timeout\":5}]}],\"Notification\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{kr_hook}\",\"args\":[\"qoder-cli\",\"hook\"],\"timeout\":5}]}]}}"
    ],
    "variables": [],
    "grant_statement": "When you run qodercli in a KalaReach session with this integration on, KalaReach adds --settings with inline settings that register the KalaReach forwarder, by the full path of the copy KalaReach installed, with the arguments qoder-cli hook, for SessionStart, SessionEnd, PostToolUse, PostToolUseFailure and Notification, with a timeout of one second for SessionEnd and five for the others. Qoder CLI runs these hooks beside your own, and nothing is written to your Qoder CLI settings. Qoder CLI starts the forwarder itself, so the forwarder runs under Qoder CLI's own permissions and outside the KalaReach plugin sandbox, outside Wasmtime. It sees those five events of that session."
  }
}
