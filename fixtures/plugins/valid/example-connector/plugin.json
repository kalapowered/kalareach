{
  "manifest_version": 1,
  "publisher_id": "kalareach",
  "plugin_name": "example-connector",
  "version": "0.1.0",
  "display_name": "Example connector package",
  "description": "Recognises the example agent, reads its protocol through a declarative table, sends prompts and answers its tool approvals.",
  "sdk_range": ">=0.1.1, <0.2.0",
  "wit_range": ">=0.1.0, <0.2.0",
  "source": {
    "repository": "https://github.com/kalapowered/kalareach-plugins",
    "revision": "refs/tags/example-connector-0.1.0"
  },
  "match_rules": [
    {
      "id": "example-agent",
      "executable": {
        "file_stem": "example-agent",
        "path_suffix": [],
        "version_range": ">=1.0.0, <2.0.0"
      },
      "distribution": {
        "registry": "npm",
        "package": "@kalareach/example-agent"
      },
      "confidence": "exact"
    }
  ],
  "platforms": [
    {
      "os": "linux",
      "architectures": [
        "x86_64",
        "aarch64"
      ]
    },
    {
      "os": "mac_os",
      "architectures": [
        "aarch64"
      ]
    }
  ],
  "payloads": [
    {
      "role": "connector",
      "path": "connector.json",
      "digest": "161edfac685266be2184090eccb7944c4ae64a13317355ef41ef4b6645a5d98e",
      "size_bytes": "3139"
    },
    {
      "role": "presentation",
      "path": "presentation.json",
      "digest": "c51b6643a1f3d39a1b64ca042c5e19351ab688b2cc0e22a58275b3b7fb3d634e",
      "size_bytes": "5649"
    }
  ],
  "capabilities": [
    {
      "capability": "metadata.match",
      "reason": "Recognise the example agent from its executable and its package"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Present the prompt form and the current activity"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read turn state from the application's own protocol"
    },
    {
      "capability": "upstream.action",
      "reason": "Send a prompt the person wrote to the bound application"
    },
    {
      "capability": "approval.decode",
      "reason": "Read which tool call an approval request is about and the decisions it offers"
    },
    {
      "capability": "approval.respond",
      "reason": "Answer a tool approval the application is waiting on with the decision a person made"
    }
  ],
  "actions": [
    {
      "id": "prompt.send",
      "label": "Send prompt",
      "effect": "upstream.prompt",
      "implementation": {
        "type": "upstream_method",
        "method": "turn.start",
        "bindings": [
          {
            "parameter": "text",
            "field": {
              "segments": [
                {
                  "type": "member",
                  "name": "params"
                },
                {
                  "type": "member",
                  "name": "prompt"
                }
              ]
            }
          },
          {
            "parameter": "queue",
            "field": {
              "segments": [
                {
                  "type": "member",
                  "name": "params"
                },
                {
                  "type": "member",
                  "name": "queue"
                }
              ]
            }
          }
        ]
      },
      "parameters": {
        "parameters": [
          {
            "name": "text",
            "kind": {
              "type": "text",
              "max_length": 8000,
              "multiline": true
            },
            "label": "Prompt",
            "required": true
          },
          {
            "name": "queue",
            "kind": {
              "type": "boolean"
            },
            "label": "Queue behind the current turn",
            "required": false
          }
        ]
      },
      "description": "Start a turn with the prompt the person wrote",
      "confirmation_required": false
    },
    {
      "id": "approval.answer",
      "label": "Answer",
      "effect": "approval.respond",
      "implementation": {
        "type": "decision_destination",
        "decision": "decision"
      },
      "parameters": {
        "parameters": [
          {
            "name": "decision",
            "kind": {
              "type": "choice",
              "choices": [
                {
                  "id": "allow",
                  "label": "Allow"
                },
                {
                  "id": "deny",
                  "label": "Deny"
                }
              ]
            },
            "label": "Decision",
            "required": true
          }
        ]
      },
      "description": "Answer the tool approval the application is waiting on",
      "confirmation_required": false
    }
  ],
  "attachments": null,
  "native_bridge": null
}
