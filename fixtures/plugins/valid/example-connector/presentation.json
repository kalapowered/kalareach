{
  "manifest_version": 1,
  "base_revision": "1",
  "nodes": [
    {
      "id": "compose",
      "revision": "1",
      "body": {
        "kind": "form",
        "title": "Prompt",
        "fields": {
          "parameters": [
            {
              "name": "text",
              "kind": {
                "type": "text",
                "max_length": 8000,
                "multiline": true
              },
              "label": "Prompt",
              "required": true
            },
            {
              "name": "queue",
              "kind": {
                "type": "boolean"
              },
              "label": "Queue behind the current turn",
              "required": false
            }
          ]
        },
        "submit": {
          "id": "send",
          "revision": "1",
          "label": "Send prompt",
          "icon": "send",
          "accessible_description": "Send the prompt to the bound application",
          "action_id": "prompt.send",
          "parameters": {
            "parameters": [
              {
                "name": "text",
                "kind": {
                  "type": "text",
                  "max_length": 8000,
                  "multiline": true
                },
                "label": "Prompt",
                "required": true
              },
              {
                "name": "queue",
                "kind": {
                  "type": "boolean"
                },
                "label": "Queue behind the current turn",
                "required": false
              }
            ]
          },
          "priority": "primary",
          "visible_when": {
            "op": "grant",
            "right": "agent.prompt"
          },
          "enabled_when": {
            "op": "all",
            "terms": [
              {
                "op": "binding",
                "state": "bound"
              },
              {
                "op": "not",
                "term": {
                  "op": "binding",
                  "state": "upstream_busy"
                }
              }
            ]
          },
          "disabled_reason": "The application is working on the last prompt"
        }
      }
    },
    {
      "id": "activity",
      "revision": "1",
      "body": {
        "kind": "progress",
        "label": "Working",
        "state": {
          "kind": "indeterminate"
        }
      }
    },
    {
      "id": "approval",
      "revision": "1",
      "body": {
        "kind": "action_group",
        "label": "Tool approval",
        "controls": [
          {
            "id": "allow",
            "revision": "1",
            "label": "Allow",
            "icon": "check",
            "accessible_description": "Allow the tool call the application is waiting on",
            "action_id": "approval.answer",
            "parameters": {
              "parameters": [
                {
                  "name": "decision",
                  "kind": {
                    "type": "choice",
                    "choices": [
                      {
                        "id": "allow",
                        "label": "Allow"
                      }
                    ]
                  },
                  "label": "Decision",
                  "required": true
                }
              ]
            },
            "priority": "primary",
            "visible_when": {
              "op": "all",
              "terms": [
                {
                  "op": "grant",
                  "right": "agent.approval.respond"
                },
                {
                  "op": "flag",
                  "flag": "pending_approval"
                }
              ]
            },
            "enabled_when": {
              "op": "not",
              "term": {
                "op": "binding",
                "state": "native_only_volatile"
              }
            },
            "disabled_reason": "Answers wait until this host can record them again"
          },
          {
            "id": "deny",
            "revision": "1",
            "label": "Deny",
            "icon": "cross",
            "accessible_description": "Deny the tool call the application is waiting on",
            "action_id": "approval.answer",
            "parameters": {
              "parameters": [
                {
                  "name": "decision",
                  "kind": {
                    "type": "choice",
                    "choices": [
                      {
                        "id": "deny",
                        "label": "Deny"
                      }
                    ]
                  },
                  "label": "Decision",
                  "required": true
                }
              ]
            },
            "priority": "secondary",
            "visible_when": {
              "op": "all",
              "terms": [
                {
                  "op": "grant",
                  "right": "agent.approval.respond"
                },
                {
                  "op": "flag",
                  "flag": "pending_approval"
                }
              ]
            },
            "enabled_when": {
              "op": "not",
              "term": {
                "op": "binding",
                "state": "native_only_volatile"
              }
            },
            "disabled_reason": "Answers wait until this host can record them again"
          }
        ]
      }
    }
  ],
  "voice": {
    "status_nodes": [
      "activity"
    ],
    "choice_controls": [
      "send",
      "allow",
      "deny"
    ],
    "detail_nodes": []
  }
}
