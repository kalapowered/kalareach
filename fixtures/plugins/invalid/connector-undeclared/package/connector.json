{
  "manifest_version": 1,
  "plugin_id": "kalareach/example-declarative",
  "protocol": {
    "name": "example-rpc",
    "qualified_range": ">=1.0.0, <2.0.0",
    "tested_version": "1.0.0"
  },
  "transport": "stdio",
  "framing": {
    "type": "line_delimited_json",
    "max_message_bytes": 1048576
  },
  "request_id_path": {
    "segments": [
      {
        "type": "member",
        "name": "id"
      }
    ]
  },
  "method_path": {
    "segments": [
      {
        "type": "member",
        "name": "method"
      }
    ]
  },
  "response_correlation": {
    "type": "matching_id",
    "id_path": {
      "segments": [
        {
          "type": "member",
          "name": "id"
        }
      ]
    }
  },
  "routes": [
    {
      "method": "status.read",
      "wire_name": "status/read",
      "direction": "host_to_upstream"
    }
  ],
  "methods": [
    {
      "method": "status.read",
      "class": "observation",
      "evidence": "Returns the current turn state"
    }
  ],
  "volatile_forwarding": false,
  "qualification_note": null
}
