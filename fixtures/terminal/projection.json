{
  "what": "The projected renderer's corpus: what a client draws for a canonical screen, and what it must never do to the destination.",
  "covers": [
    "KR-REQ-08.40",
    "KR-ACC-023"
  ],
  "rules": [
    "Autowrap is cleared before the first cell of every frame and the session's own value is put back after the last.",
    "Every run is placed with an absolute cursor address, so a glyph the destination measures differently moves nothing after it.",
    "A cluster the window's edge falls inside is replaced by one space for each cell of it that is inside, never half drawn.",
    "A run whose text does not measure the cell span the session gave it is replaced by spaces for that span and counted.",
    "No frame contains a line feed, an index, a scroll or a line insertion, so nothing the renderer writes can scroll the destination.",
    "Each expected line is one entry per destination cell: the cluster drawn there, or an empty string for the second cell of a wide cluster.",
    "A frame clears each line it draws before it draws on it, so a row with no run at column zero and a row shorter than the one before it both leave nothing of what was there."
  ],
  "cases": [
    {
      "id": "emoji_then_ascii",
      "why": "A multi-codepoint emoji followed by ASCII, as the engine's own width corpus records it: the pinned model measures per scalar, so the joined sequence is two cells and two cells with the joiner belonging to the first, and the ASCII after it lands on its own canonical columns rather than wherever the destination's advance left it.",
      "window": {
        "top_row": 0,
        "left_column": 0,
        "rows": 2,
        "columns": 10
      },
      "rows": [
        {
          "row": 0,
          "soft_wrapped": false,
          "runs": [
            {
              "column": 0,
              "cells": 6,
              "text": "👩‍💻AB"
            }
          ]
        }
      ],
      "cursor": {
        "column": 6,
        "row": 0,
        "visible": true,
        "style": 1,
        "pending_wrap": false
      },
      "lines": [
        [
          "👩‍",
          "",
          "💻",
          "",
          "A",
          "B",
          " ",
          " ",
          " ",
          " "
        ],
        [
          " ",
          " ",
          " ",
          " ",
          " ",
          " ",
          " ",
          " ",
          " ",
          " "
        ]
      ],
      "cursor_cell": [
        0,
        6
      ],
      "expect": {
        "runs_replaced": 0,
        "clusters_replaced": 0,
        "cells_clipped": 0,
        "soft_wraps": 0,
        "pending_wrap": false,
        "cursor_outside": false
      }
    },
    {
      "id": "right_margin_splits_a_wide_cluster",
      "why": "The window's right edge falls inside a wide cluster. Half a wide character is not a narrower character, so the cell inside the window gets a space and the cluster is counted as replaced; the run beyond the edge is clipped entirely.",
      "window": {
        "top_row": 0,
        "left_column": 0,
        "rows": 1,
        "columns": 5
      },
      "rows": [
        {
          "row": 0,
          "soft_wrapped": false,
          "runs": [
            {
              "column": 0,
              "cells": 4,
              "text": "near"
            },
            {
              "column": 4,
              "cells": 2,
              "text": "😀"
            },
            {
              "column": 6,
              "cells": 3,
              "text": "far"
            }
          ]
        }
      ],
      "cursor": {
        "column": 0,
        "row": 0,
        "visible": true,
        "style": 1,
        "pending_wrap": false
      },
      "lines": [
        [
          "n",
          "e",
          "a",
          "r",
          " "
        ]
      ],
      "cursor_cell": [
        0,
        0
      ],
      "expect": {
        "runs_replaced": 0,
        "clusters_replaced": 1,
        "cells_clipped": 4,
        "soft_wraps": 0,
        "pending_wrap": false,
        "cursor_outside": false
      }
    },
    {
      "id": "left_margin_splits_a_wide_cluster",
      "why": "The same at the other margin. A window panned one column into a wide cluster shows one cell of it, and that cell is a space rather than the right half of a glyph.",
