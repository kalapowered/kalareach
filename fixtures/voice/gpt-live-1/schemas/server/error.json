{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reach.kala.to/schemas/providers/gpt-live-1/server/error.json",
  "title": "Session error",
  "description": "A rejected command or a session error. Some errors end the session and some do not, so read the lifecycle rather than assuming either.",
  "type": "object",
  "properties": {
    "type": {
      "const": "error"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Provider-assigned identifier for this server event."
    },
    "client_event_id": {
      "type": "string",
      "minLength": 1,
      "description": "The event_id of the broker command this event answers, when the broker supplied one."
    },
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "param": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_event_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "event_id",
    "error"
  ],
  "additionalProperties": false
}
