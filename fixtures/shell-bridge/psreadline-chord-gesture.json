                  "keymap": "emacs",
                  "pending": {
                    "quoted_insertion": false,
                    "macro_input": false,
                    "search": false,
                    "numeric_argument": false,
                    "multikey_sequence": false,
                    "vi_motion": false,
                    "paste": false
                  }
                }
              }
