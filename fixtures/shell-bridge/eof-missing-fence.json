{
  "id": "eof-missing-fence",
  "purpose": "With no fence the gesture is consumed rather than turned into an empty-prompt end of file, and the hint appears once per prompt.",
  "covers": [
    "KR-REQ-07.81",
    "KR-REQ-07.74"
  ],
  "shells": [
    "zsh",
    "bash",
    "fish",
    "powershell"
  ],
  "script": {
    "pre_eof": {
      "view": {
        "session_id": "11111111-1111-1111-1111-111111111111",
        "fence": null,
        "gesture": {
          "terminal_eof": {
            "byte": "4"
          }
        },
        "pending_gesture": null,
        "hinted_for": null
      },
      "steps": [
        {
          "offer": {
            "name": "the-first-gesture-at-this-prompt-prints-the-hint",
            "context": {
              "prompt_generation": "1",
              "reader_revision": "1",
              "key": {
                "byte": {
                  "byte": "4"
                }
              },
              "condition": {
                "managed_root_editor": true,
                "reader_context": "primary",
                "source": "terminal",
                "editor": {
                  "buffer_revision": "1",
                  "buffer_empty": true,
                  "keymap": "emacs",
                  "pending": {
                    "quoted_insertion": false,
                    "macro_input": false,
                    "search": false,
                    "numeric_argument": false,
                    "multikey_sequence": false,
                    "vi_motion": false,
                    "paste": false
                  }
                }
              }
            },
            "expect": {
              "consume": {
                "hint": "Use kr detach --attachment <id> to detach.",
                "reason": "fence_missing"
              }
            }
          }
        },
        {
          "offer": {
            "name": "the-second-at-the-same-prompt-is-silent",
            "context": {
              "prompt_generation": "1",
              "reader_revision": "1",
              "key": {
                "byte": {
                  "byte": "4"
                }
              },
              "condition": {
                "managed_root_editor": true,
                "reader_context": "primary",
                "source": "terminal",
                "editor": {
                  "buffer_revision": "1",
                  "buffer_empty": true,
                  "keymap": "emacs",
                  "pending": {
                    "quoted_insertion": false,
                    "macro_input": false,
                    "search": false,
                    "numeric_argument": false,
                    "multikey_sequence": false,
                    "vi_motion": false,
                    "paste": false
                  }
                }
              }
            },
            "expect": {
              "consume": {
                "hint": null,
                "reason": "fence_missing"
              }
            }
          }
        },
        {
          "offer": {
            "name": "the-next-prompt-may-hint-again",
            "context": {
              "prompt_generation": "2",
              "reader_revision": "1",
              "key": {
                "byte": {
                  "byte": "4"
                }
              },
              "condition": {
                "managed_root_editor": true,
                "reader_context": "primary",
                "source": "terminal",
                "editor": {
                  "buffer_revision": "1",
                  "buffer_empty": true,
                  "keymap": "emacs",
                  "pending": {
                    "quoted_insertion": false,
                    "macro_input": false,
                    "search": false,
                    "numeric_argument": false,
                    "multikey_sequence": false,
                    "vi_motion": false,
                    "paste": false
                  }
                }
              }
            },
            "expect": {
              "consume": {
                "hint": "Use kr detach --attachment <id> to detach.",
                "reason": "fence_missing"
              }
            }
          }
        },
        {
          "publish": {
            "fence_id": "f1f1f1f1-f1f1-f1f1-f1f1-f1f1f1f1f1f1",
            "root_process": {
              "pid": "4242",
              "source": "macos_proc_bsd_info",
              "start_value": "900"
            },
            "prompt_generation": "2",
            "reader_revision": "1",
            "input_epoch": "3",
            "originating_attachment": "a1a1a1a1-a1a1-a1a1-a1a1-a1a1a1a1a1a1"
          }
        },
        {
          "offer": {
            "name": "a-fence-from-an-earlier-prompt-is-stale",
            "context": {
              "prompt_generation": "3",
              "reader_revision": "1",
              "key": {
                "byte": {
                  "byte": "4"
                }
              },
              "condition": {
                "managed_root_editor": true,
                "reader_context": "primary",
                "source": "terminal",
                "editor": {
                  "buffer_revision": "1",
                  "buffer_empty": true,
                  "keymap": "emacs",
                  "pending": {
                    "quoted_insertion": false,
                    "macro_input": false,
                    "search": false,
                    "numeric_argument": false,
                    "multikey_sequence": false,
                    "vi_motion": false,
                    "paste": false
                  }
                }
              }
            },
            "expect": {
              "consume": {
                "hint": "Use kr detach --attachment <id> to detach.",
                "reason": "fence_stale"
              }
            }
          }
        },
        {
          "publish": {
            "fence_id": "f2f2f2f2-f2f2-f2f2-f2f2-f2f2f2f2f2f2",
            "root_process": {
              "pid": "4242",
              "source": "macos_proc_bsd_info",
              "start_value": "900"
            },
            "prompt_generation": "3",
            "reader_revision": "1",
            "input_epoch": "3",
            "originating_attachment": "a1a1a1a1-a1a1-a1a1-a1a1-a1a1a1a1a1a1"
          }
        },
        {
          "offer": {
            "name": "a-fence-from-a-reader-this-one-replaced-is-stale-too",
            "context": {
              "prompt_generation": "3",
              "reader_revision": "2",
              "key": {
                "byte": {
                  "byte": "4"
                }
              },
              "condition": {
                "managed_root_editor": true,
                "reader_context": "primary",
                "source": "terminal",
                "editor": {
                  "buffer_revision": "1",
                  "buffer_empty": true,
                  "keymap": "emacs",
                  "pending": {
                    "quoted_insertion": false,
                    "macro_input": false,
                    "search": false,
                    "numeric_argument": false,
                    "multikey_sequence": false,
                    "vi_motion": false,
                    "paste": false
                  }
                }
              }
            },
            "expect": {
              "consume": {
                "hint": null,
                "reason": "fence_stale"
              }
            }
          }
        }
      ]
    }
  }
}
