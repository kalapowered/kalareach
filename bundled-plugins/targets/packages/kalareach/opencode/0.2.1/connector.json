      "evidence": "Reports a stored message's new state"
    },
    {
      "method": "models-dev.refreshed",
      "class": "observation",
      "evidence": "Reports that the shared model catalogue was refreshed"
    },
    {
      "method": "permission.asked",
      "class": "observation",
      "evidence": "Reports a pending permission on the same stream under the earlier name"
    },
    {
      "method": "permission.replied",
      "class": "observation",
      "evidence": "Reports a pending permission's resolution under the earlier name"
    },
    {
      "method": "permission.v2.asked",
      "class": "observation",
      "evidence": "Reports that a permission is pending, with its identifier, session, action and resources; answering it is a separate operation this table does not carry"
    },
    {
      "method": "permission.v2.replied",
      "class": "observation",
      "evidence": "Reports the answer that resolved a pending permission; the resolution happened before the event"
    },
    {
      "method": "plugin.added",
      "class": "observation",
      "evidence": "Reports that a plugin was loaded into this server"
    },
    {
      "method": "project.directories.updated",
      "class": "observation",
      "evidence": "Reports the directory set a project covers"
    },
    {
      "method": "project.updated",
      "class": "observation",
      "evidence": "Reports a project record's new state"
    },
    {
      "method": "pty.created",
