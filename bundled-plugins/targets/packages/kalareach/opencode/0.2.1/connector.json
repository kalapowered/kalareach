      "evidence": "Reports that an MCP authorisation page could not be opened"
    },
    {
      "method": "mcp.tools.changed",
      "class": "observation",
      "evidence": "Reports that a connected MCP server's tool list changed"
    },
    {
      "method": "message.part.delta",
      "class": "observation",
      "evidence": "Carries an incremental change to a message part already reported"
    },
    {
      "method": "message.part.removed",
      "class": "observation",
      "evidence": "Reports that a stored message part was removed"
    },
    {
      "method": "message.part.updated",
      "class": "observation",
      "evidence": "Reports a stored message part's new state"
    },
    {
      "method": "message.removed",
