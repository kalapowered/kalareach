      "method": "installation.updated",
      "class": "observation",
      "evidence": "Reports the installed version this server is running"
    },
    {
      "method": "integration.connection.updated",
      "class": "observation",
      "evidence": "Names an integration whose connection state changed; it carries the identifier only, never the credential"
    },
    {
      "method": "integration.updated",
      "class": "observation",
      "evidence": "Reports that the installed integration list has changed"
    },
    {
      "method": "lsp.updated",
