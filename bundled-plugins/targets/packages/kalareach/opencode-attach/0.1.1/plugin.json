  "plugin_name": "opencode-attach",
  "version": "0.1.1",
  "display_name": "OpenCode (serve and attach)",
  "description": "Recognises OpenCode, reads the event stream of a server started with opencode serve and attached to with opencode attach through a declarative table, and stops the turn it is running.",
  "sdk_range": ">=0.1.1, <0.2.0",
  "wit_range": ">=0.1.0, <0.2.0",
