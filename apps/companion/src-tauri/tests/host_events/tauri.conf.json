{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Host event check",
  "version": "0.1.0",
  "identifier": "to.kala.reach.host-event-check",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../icons/32x32.png"]
  }
}
