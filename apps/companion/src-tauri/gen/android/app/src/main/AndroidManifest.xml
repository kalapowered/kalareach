<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Showing a notification at all, from Android 13 on. The person still grants it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Voice. The microphone is opened only for a call the person started, and the foreground
      service below is what keeps that call running when the screen locks. Section 15 paragraph 21
      is precise that this preserves an explicitly started call and does not authorise unattended
      microphone activation.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Reading whether a phone call is in progress, so an interruption is an explicit state. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Camera and photo input, which the WebView's own file chooser opens. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.companion_tauri"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!--
              The sign-in's answer, when a browser without Auth Tab carries the ceremony in a Custom
              Tab: the service redirects to this address, and a verified link hands it to this
              activity. Verification needs the domain's asset links to name this package and its
              signing certificate.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="reach.kala.to" android:path="/app/oauth/callback" />
            </intent-filter>
        </activity>

        <!--
          The push receiver. The system starts it with no activity and no WebView running, which
          is the point: a notification must arrive whether or not the interface exists.
        -->
        <service
            android:name="to.kala.reach.companion.push.KalaReachMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          The call itself. A microphone foreground service is what Android requires before capture
          continues with the screen locked, and its notification is what makes the call visible:
          section 15 paragraph 22 wants user-visible native playback, mute and stop to stay
          available, and the notification carries them.
        -->
        <service
            android:name="to.kala.reach.companion.voice.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
