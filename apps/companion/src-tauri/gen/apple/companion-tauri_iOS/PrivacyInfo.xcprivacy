<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The application's privacy manifest, held to the built application by
	apps/companion/scripts/privacy-manifest.mjs. The release product is what ships, so the
	categories below are the ones its executable imports, whichever package they come from. The
	Swift packages linked statically (Firebase Messaging and what it needs) also ship manifests of
	their own, and so does the WebRTC framework. docs/releases/app-store-privacy.md ties each entry
	to the code and to the answers the App Store asks for.
-->
<plist version="1.0">
<dict>
	<!--
		Tracking. The application does not track. It links neither AdSupport nor
		AppTrackingTransparency, carries no advertising library and no analytics product (the Google
		libraries in it are Firebase Messaging and what it needs), and sends nothing to a data broker.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
		Data collected. Each entry is data that leaves the device to a service the application
		reaches and that the service (or its provider) can read and keeps beyond answering the
		request. Each is tied to the account or installation that sent it, and none is used for
		tracking. Content the application seals on the device before sending (settings, drafts, the
		recovery bundle) is not here: the sync service holds ciphertext it cannot read, and Apple
		counts data stored in a readable form.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Signing in to a managed account: the address the person gives the sign-in page. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- An organisation's identity provider can supply a name at an organisation sign-in; the
			account service keeps it and the application reads it back. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The account identifier a sign-in returns, and the identifier of the installation. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			The keys that identify this device to the services (the endpoint key a relay and the
			discovery service see, the installation key that signs requests), the notification
			registration token Firebase makes for the Apple push token, and the network address a
			sign-in request carried, which the account service keeps in the session record.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- A managed voice call: the person's speech goes from the device to the voice provider, which
			may keep it for 30 days for abuse monitoring (the service's provider profile says so). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The transcripts of a managed voice call, which the provider makes from the person's speech
			and the model's replies and holds on the same terms as the audio. The managed broker
			discards them before anything is written. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The relay bytes, voice seconds and stored bytes the services count against an allowance. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUsageData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- How long the voice service took to create a call and to make it ready, kept with the call. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			The operational events of a voice call (error codes, usage counters), kept with the call, and
			the user agent of the sign-in request, kept in the session record.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
			File timestamps. The executable imports stat, lstat and fstat, NSFileModificationDate, and
			(from GoogleUtilities' network session, which has its own manifest) NSURLCreationDateKey.

			C617.1, "Declare this reason to access the timestamps, size, or other metadata of files
			inside the app container, app group container, or the app’s CloudKit container.": the
			standard library's file calls, which the pairing records, the attempt budget, the
			descriptor directory, the installation record, drafts, settings, the recovery record and
			the sync membership make on files and directories in the application's own container
			(whether a path exists, is a file or a directory, its size and its owner and mode), which
			Tauri and its opener plugin make on the application's own resource directory and on the
			paths they are asked to open, and which the standard library's backtrace symbolizer makes on
			the application's own executable.

			3B52.1, "Declare this reason to access the timestamps, size, or other metadata of files or
			directories that the user specifically granted access to, such as using a document picker
			view controller.": the dialog plugin's file picker reads the modification date of the file
			the person chose, for the picker's result.

			Two uses have no reason in Apple's list. Each reads the type or the size of a file that is
			neither in the container nor one the person chose, and no timestamp. libsodium's random
			source checks with fstat that /dev/urandom is a character device (sodium_init,
			randombytes_stir, randombytes_sysrandom_stir). The Rust standard library, asked the system
			version, reads the system version property list under the Simulator, or when the
			sysctlbyname it asks first fails (std::fs::read, reached from __isPlatformVersionAtLeast).
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
		<!--
			System boot time. The voice call adapter reads ProcessInfo.systemUptime to measure how
			long the call's owner has been silent, so that a call whose owner has gone is ended.
			35F9.1, "Declare this reason to access the system boot time in order to measure the amount
			of time that has elapsed between events that occurred within the app or to perform
			calculations to enable timers." Nothing read here, or derived from it, leaves the device.
			The WebRTC framework has its own manifest for its own use.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!--
			User defaults. The executable imports NSUserDefaults for the Firebase and GoogleUtilities
			packages linked into it: Firebase Core keeps its data collection switch and its logging
			mode there, and GoogleUtilities has a wrapper around it. The application's own code does
			not use user defaults. CA92.1, "Declare this reason to access user defaults to read and
			write information that is only accessible to the app itself." Those packages declare their
			own reasons in their own manifests as well.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
