# Generated by the build from the capability files beside it.
src-tauri/gen/schemas/

# Where a mobile build copies the interface bundle before it packages it.
src-tauri/gen/apple/assets/

# The test harness's bundle, which is never what a desktop build carries.
dist-harness/

# Playwright's own output when a run is not pointed at the shared artefact directory.
playwright-report/
test-results/
