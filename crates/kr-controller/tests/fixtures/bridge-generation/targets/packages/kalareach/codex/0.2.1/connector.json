  "methods": [
    {
      "method": "initialize",
      "class": "mutation",
      "evidence": "Negotiates this connection's capability opt-ins, including experimentalApi, so it changes what the connection may afterwards call"
    },
    {
      "method": "thread.start",
      "class": "mutation",
      "evidence": "Creates a thread and subscribes this connection to its turn and item events"
    },
    {
      "method": "thread.resume",
      "class": "mutation",
      "evidence": "Loads a stored thread so later turns append to it"
    },
    {
      "method": "thread.fork",
      "class": "mutation",
      "evidence": "Copies stored history into a new thread id"
    },
    {
      "method": "thread.read",
      "class": "observation",
      "evidence": "Reads a stored thread by id without resuming it or subscribing to it"
    },
    {
      "method": "thread.list",
      "class": "observation",
      "evidence": "Pages through stored thread logs"
    },
    {
      "method": "thread.turns.list",
      "class": "observation",
      "evidence": "Pages through a stored thread's turn history without resuming it"
    },
    {
      "method": "thread.loaded.list",
      "class": "observation",
      "evidence": "Lists the thread ids currently loaded in memory"
    },
    {
      "method": "thread.unsubscribe",
      "class": "mutation",
      "evidence": "Drops this connection's subscription; when it was the last one the server unloads the thread after a no-subscriber grace period"
    },
    {
      "method": "thread.archive",
      "class": "mutation",
      "evidence": "Moves a thread's log into the archived directory and attempts the same for descendant logs that are not already archived"
    },
    {
      "method": "thread.delete",
      "class": "mutation",
      "evidence": "Permanently deletes a persisted thread and its spawned descendants"
    },
    {
      "method": "thread.compact.start",
      "class": "mutation",
      "evidence": "Rewrites the thread's conversation history by compaction"
    },
    {
      "method": "thread.inject-items",
      "class": "mutation",
      "evidence": "Appends items to a loaded thread's model-visible history and persists them"
    },
    {
      "method": "thread.shell-command",
      "class": "unsupported",
      "evidence": "Runs a command outside the sandbox with full access and does not inherit the thread sandbox policy"
    },
    {
      "method": "turn.start",
      "class": "mutation",
      "evidence": "Starts generation against the thread and writes to the workspace the sandbox policy allows"
    },
    {
      "method": "turn.steer",
      "class": "mutation",
      "evidence": "Appends user input to the turn named by expectedTurnId, which must be the active turn"
    },
    {
      "method": "turn.interrupt",
      "class": "mutation",
      "evidence": "Cancels the in-flight turn, which ends with status interrupted"
    },
    {
      "method": "review.start",
      "class": "mutation",
      "evidence": "Starts a reviewer run for the thread and streams review items"
    },
    {
      "method": "model.list",
      "class": "observation",
      "evidence": "Lists available models and their effort options"
    },
    {
      "method": "mcp-server.tool.call",
      "class": "mutation",
      "evidence": "Calls a tool on a configured MCP server, whose effect this table cannot bound"
    },
    {
      "method": "command.exec",
      "class": "unsupported",
      "evidence": "Runs a command under the server sandbox with no thread or turn to bind it to"
    },
    {
      "method": "process.spawn",
      "class": "unsupported",
      "evidence": "Starts a process session outside the Codex sandbox"
    },
    {
      "method": "config.value.write",
      "class": "unsupported",
      "evidence": "Writes a key into the user's config.toml on disk"
    },
    {
      "method": "config.batch-write",
      "class": "unsupported",
      "evidence": "Applies configuration edits to the user's config.toml on disk"
    },
    {
      "method": "fs.read-file",
      "class": "unsupported",
      "evidence": "Reads an absolute path through the app-server rather than through the host's own file grant"
    },
    {
      "method": "fs.write-file",
      "class": "unsupported",
      "evidence": "Writes an absolute path through the app-server rather than through the host's own file grant"
    },
    {
      "method": "fs.remove",
      "class": "unsupported",
      "evidence": "Removes an absolute path through the app-server rather than through the host's own file grant"
    },
    {
      "method": "account.read",
      "class": "credential",
      "evidence": "Reports the signed-in account and authentication state; the broker keeps the answer"
    },
    {
      "method": "account.login.start",
      "class": "credential",
      "evidence": "Begins a login that carries an API key or a ChatGPT authorisation flow"
    },
    {
      "method": "account.logout",
      "class": "unsupported",
      "evidence": "Discards the stored credentials of the account the person signed in with"
    },
    {
      "method": "thread.started",
      "class": "observation",
      "evidence": "Reports that a thread was created or resumed"
    },
    {
      "method": "thread.closed",
      "class": "observation",
      "evidence": "Reports that the last subscriber left and the thread was unloaded"
    },
    {
      "method": "thread.status.changed",
      "class": "observation",
      "evidence": "Reports a loaded thread's runtime status"
    },
    {
      "method": "thread.queue.changed",
      "class": "observation",
      "evidence": "Reports that the thread's queued input changed; the notification names the thread and carries no queue contents"
    },
    {
      "method": "turn.started",
      "class": "observation",
      "evidence": "Reports that a turn began and names its id"
    },
    {
      "method": "turn.completed",
      "class": "observation",
      "evidence": "Reports the turn's final status"
    },
    {
      "method": "turn.diff.updated",
      "class": "observation",
      "evidence": "Reports the turn's accumulated diff"
    },
    {
      "method": "item.started",
      "class": "observation",
      "evidence": "Reports an item the turn began, such as a command execution or a file change"
    },
    {
      "method": "item.completed",
      "class": "observation",
      "evidence": "Reports an item's final state"
    },
    {
      "method": "item.agent-message.delta",
      "class": "observation",
      "evidence": "Streams assistant message text"
    },
    {
      "method": "server-request.resolved",
      "class": "observation",
      "evidence": "Reports that a pending server request was answered or cleared"
    },
    {
      "method": "warning",
      "class": "observation",
      "evidence": "Reports a non-fatal runtime warning"
    },
    {
      "method": "error",
      "class": "observation",
      "evidence": "Reports an error the server raised outside a request"
    },
    {
      "method": "item.command-execution.request-approval",
      "class": "mutation",
      "evidence": "A reverse request whose answer runs or refuses a command; answering changes what the agent does"
    },
    {
      "method": "item.file-change.request-approval",
      "class": "mutation",
      "evidence": "A reverse request whose answer applies or refuses a file change"
    },
    {
      "method": "item.permissions.request-approval",
      "class": "mutation",
      "evidence": "A reverse request whose answer grants network or filesystem permissions, optionally for the whole session"
    },
    {
      "method": "item.tool.request-user-input",
      "class": "mutation",
      "evidence": "A reverse request whose answer becomes tool input the model acts on"
    },
    {
      "method": "mcp-server.elicitation.request",
      "class": "mutation",
      "evidence": "A reverse request from a downstream MCP server whose answer it receives as structured input"
    },
    {
      "method": "account.chatgpt-auth-tokens.refresh",
      "class": "credential",
      "evidence": "A reverse request for refreshed ChatGPT tokens; the broker answers it and never passes the tokens to a component"
    }
  ],
  "decision_destination": null,
  "volatile_forwarding": false,
  "qualification_note": "Qualified against Codex CLI 0.155.1 (npm @openai/codex), whose macOS arm64 executable is sha256 8eaf1ad12fe6bf89b1710330f58900014322c7c5af677e43be116d8ac5fc0a9e, the App Server documentation at learn.chatgpt.com/docs/app-server and the JSON Schema that binary's generate-json-schema writes, both read 2026-09-20. Every wire name here is in that schema except process/spawn, which the documentation describes as experimental behind the experimentalApi capability and which no request union lists. The table covers the connection between the broker and the App Server; the native --remote client speaks WebSocket and is the gateway listener's. max_message_bytes is this host's bound, not one the vendor states. Volatile forwarding is untested. fixtures/frames.json pins the evidence."
}
