{
  "manifest_version": 1,
  "publisher_id": "kalareach",
  "plugin_name": "qoder-cli",
  "version": "0.2.1",
  "display_name": "Qoder CLI",
  "description": "Recognises Qoder CLI, reads its agent protocol through a declarative table and stops the turn it is running, with the terminal as the default route.",
  "sdk_range": ">=0.1.1, <0.2.0",
  "wit_range": ">=0.1.0, <0.2.0",
  "source": {
    "repository": "https://github.com/kalapowered/kalareach-plugins",
    "revision": "aea3b0db45c5883fc7d110d57b9ae6bcb92f707d"
  },
  "match_rules": [
    {
      "id": "qoder-cli-entry",
      "executable": {
        "file_stem": "qoder",
        "path_suffix": [
          ".qoder",
          "entry"
        ],
        "version_range": null
      },
      "distribution": null,
      "confidence": "inferred"
    },
    {
      "id": "qoder-cli-command",
      "executable": {
        "file_stem": "qodercli",
        "path_suffix": [],
        "version_range": null
      },
      "distribution": null,
      "confidence": "inferred"
    },
    {
      "id": "qoder-cli-executable",
      "executable": {
        "file_stem": "qoder",
        "path_suffix": [],
        "version_range": null
      },
      "distribution": null,
      "confidence": "inferred"
    },
    {
      "id": "qoder-cli-qualified-release",
      "executable": {
        "file_stem": "qodercli-1.1.59",
        "path_suffix": [
          ".qoder",
          "bin",
          "qodercli"
        ],
        "version_range": null
      },
      "distribution": null,
      "confidence": "inferred"
    }
  ],
  "platforms": [
    {
      "os": "linux",
      "architectures": [
        "x86_64",
        "aarch64"
      ]
    },
    {
      "os": "mac_os",
      "architectures": [
        "aarch64"
      ]
    },
    {
      "os": "windows",
      "architectures": [
        "x86_64"
      ]
    }
  ],
  "payloads": [
    {
      "role": "asset",
      "path": "README.md",
      "digest": "20dc5321f120ea24d2a32bd2a4f83fb02dc79d7fe9a13e3a695dfec86319b60d",
      "size_bytes": "5687"
    },
    {
      "role": "connector",
      "path": "connector.json",
      "digest": "e8e953a9d841999a12e689b5df870c61abc2310c668352b05317696444c0c5a4",
      "size_bytes": "8462"
    },
    {
      "role": "fixture",
      "path": "fixtures/conformance.json",
      "digest": "8240295fd5e8f51aac6091c00c5cf85a85d95689efd140facfd8c84db2538083",
      "size_bytes": "4896"
    },
    {
      "role": "asset",
      "path": "fixtures/frames.json",
      "digest": "973501047cb94056a09efe29d965cadd95e63c23f01b7c895a36c75de95a7f8b",
      "size_bytes": "7787"
    },
    {
      "role": "presentation",
      "path": "presentation.json",
      "digest": "7efcadea1c8c941e45be6e9112ff6c5244a4f7512c653759160176779ca73cc1",
      "size_bytes": "4058"
    }
  ],
  "capabilities": [
    {
      "capability": "metadata.match",
      "reason": "Recognise Qoder CLI from its own installation directory, and from the executable names it installs, as a guess"
    },
    {
      "capability": "presentation.declarative",
      "reason": "Show what the Qoder CLI session is doing and the controls for its turn"
    },
    {
      "capability": "broker.semantic_events",
      "reason": "Read the turn and tool updates the selected agent-protocol execution reports"
    },
    {
      "capability": "upstream.action",
      "reason": "Ask Qoder CLI to stop the turn it is running when you press Stop"
    }
  ],
  "actions": [
    {
      "id": "turn.cancel",
      "label": "Stop the turn",
      "effect": "upstream.cancel",
      "implementation": {
        "type": "upstream_cancel"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Cancel the turn the bound Qoder CLI execution is running, which ends it as interrupted",
      "confirmation_required": false
    },
    {
      "id": "session.refresh",
      "label": "Refresh",
      "effect": "observe",
      "implementation": {
        "type": "presentation"
      },
      "parameters": {
        "parameters": []
      },
      "description": "Draw this package's document again from the session state the host already holds",
      "confirmation_required": false
    }
  ],
  "attachments": null,
  "native_bridge": null
}
