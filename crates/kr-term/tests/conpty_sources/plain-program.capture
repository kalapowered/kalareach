# A recording of what a pseudo-console's output pipe produced while a source of
# mode 9001 ran in it. One chunk line for each read of the pipe, in order.
# source: plain-program
# command: cmd.exe /c echo kr-capture-plain
# marker: kr-capture-plain
# windows: Microsoft Windows [Version 10.0.26100.33438]
# console: portable-pty 0.9.0, flags: inherit cursor, resize quirk, win32 input mode
# exit: Some(0)
chunk \x1b[6n
chunk \x1b[?9001h\x1b[?1004h
chunk \x1b[m\x1b]0;C:\\Windows\\System32\\cmd.exe\x07\x1b[?25h
chunk kr-capture-plain\x0d\x0a
chunk \x1b[?9001l\x1b[?1004l
