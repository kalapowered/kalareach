{
  "code_rate_limited": {
    "status": 429,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "retry-after": "<seconds>"
    },
    "body": {
      "ok": false,
      "error": {
        "code": "RATE_LIMITED",
        "message": "Too many attempts. Try again shortly.",
        "retryAfterSeconds": "<seconds>"
      }
    }
  },
  "code_sent": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "ok": true,
      "data": {
        "sent": true
      }
    }
  },
  "code_unavailable": {
    "status": 503,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "retry-after": "<seconds>"
    },
    "body": {
      "ok": false,
      "error": {
        "code": "SERVICE_UNAVAILABLE",
        "message": "That could not be done just now, and nothing was changed. Try again shortly.",
        "retryAfterSeconds": "<seconds>"
      }
    }
  },
  "confirm_acknowledge": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "ok": true,
      "data": {
        "result": "acknowledge",
        "organisations": [
          {
            "organisation_id": "<id>",
            "name": "Recorded Owners",
            "members": 1
          }
        ]
      }
    }
  },
  "confirm_closed_closing": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "set-cookie": "clears the session"
    },
    "body": {
      "ok": true,
      "data": {
        "result": "closed",
        "state": "closing"
      }
    }
  },
  "confirm_closed_deleted": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "set-cookie": "clears the session"
    },
    "body": {
      "ok": true,
      "data": {
        "result": "closed",
        "state": "deleted"
      }
    }
  },
  "confirm_expired": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "ok": true,
      "data": {
        "result": "code_refused",
        "reason": "expired",
        "attempts_left": 0
      }
    }
  },
  "confirm_malformed": {
    "status": 400,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store"
    },
    "body": {
      "ok": false,
      "error": {
        "code": "INVALID_REQUEST",
        "message": "Send the code from the email and a receipt of 32 hexadecimal characters."
      }
    }
  },
  "confirm_rate_limited": {
    "status": 429,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "retry-after": "<seconds>"
    },
    "body": {
      "ok": false,
      "error": {
