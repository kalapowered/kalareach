  "confirm_unavailable": {
    "status": 503,
    "headers": {
      "content-type": "application/json",
      "cache-control": "no-store",
      "retry-after": "<seconds>"
    },
    "body": {
      "ok": false,
      "error": {
        "code": "SERVICE_UNAVAILABLE",
        "message": "That could not be confirmed just now. If it was carried out, the status of your request says so; if not, try again shortly.",
