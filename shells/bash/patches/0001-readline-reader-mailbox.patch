+}
+
+/* How much of the executing macro has still to be read.  Macro input is the reader's own, not the
+   person's, so a fence has to be able to say whether any is left. */
+int
+_rl_kr_macro_remaining (void)
+{
+  if (rl_executing_macro == 0)
+    return 0;
+  return (int) strlen (rl_executing_macro + executing_macro_index);
 }
 
