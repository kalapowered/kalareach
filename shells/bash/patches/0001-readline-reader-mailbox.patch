@@ -190,6 +193,19 @@
 _rl_pushed_input_available (void)
 {
   return (push_index != pop_index);
+}
+
+/* How many bytes this reader has already taken and not yet used.  A fence rests on the reader's
+   own state, so the count has to come from the reader rather than from the kernel's idea of what
+   is readable. */
+int
+_rl_kr_buffered (void)
+{
+  int held = push_index - pop_index;
+
+  if (held < 0)
+    held += ibuffer_len;
+  return held;
 }
 
