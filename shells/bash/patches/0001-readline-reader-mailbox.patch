+
+      /* The next character has been selected from the reader's own input sources and Readline is
+	 about to take its end-of-file decision.  This is the only point at which that decision can
+	 be taken: pending and macro input never reach a character callback, and rl_gather_tyi can
+	 call one while it fills a buffer, before preceding characters have changed rl_end.  The
+	 hook answers native or consume and replaces no binding; a consume continues this same
+	 readline call, so the shell's own ignoreeof setting is left exactly as it is. */
+      if (kr_rl_pre_eof (c) == KR_CONSUME)
+	{
+#if defined (READLINE_CALLBACKS)
+	  return (0);
+#else
+	  continue;
 #endif
 	}
 
@@ -730,7 +761,10 @@
