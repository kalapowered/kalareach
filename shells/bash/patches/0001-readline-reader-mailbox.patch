+  kr_rl_enter ();
   rl_eof_found = readline_internal_charloop ();
+  /* Before acceptance returns, so the accepted line is reported from inside the reader. */
+  kr_rl_leave (rl_eof_found == 0);
   return (readline_internal_teardown (rl_eof_found));
 }
 
