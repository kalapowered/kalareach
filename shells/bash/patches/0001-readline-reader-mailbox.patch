+
+      /* A read that produced no character: a takeover ended a pending key wait, or a launch was
+	 installed and accepted.  Readline's own abort path has already run, so the edit buffer is
+	 as it was and this call simply carries on. */
+      if (c == KR_RL_CANCEL)
+	{
+	  kr_rl_cancel_observed ();
+#if defined (READLINE_CALLBACKS)
+	  return (0);
+#else
+	  continue;
+#endif
