+	   $(srcdir)/kr_bridge_crypto.c $(srcdir)/kr_bridge_reply.c \
+	   $(srcdir)/kr_bridge_rl.c
 
 # The header files for this library.
 HSOURCES = readline.h rldefs.h chardefs.h keymaps.h history.h histlib.h \
@@ -109,7 +110,7 @@
 	  util.o kill.o undo.o macro.o input.o callback.o terminal.o \
 	  text.o nls.o misc.o $(HISTOBJ) $(TILDEOBJ) $(COLORSOBJ) \
 	  xmalloc.o xfree.o compat.o \
-	  kr_bridge.o kr_bridge_cbor.o kr_bridge_crypto.o kr_bridge_rl.o 
+	  kr_bridge.o kr_bridge_cbor.o kr_bridge_crypto.o kr_bridge_reply.o kr_bridge_rl.o 
 
 # The texinfo files which document this library.
