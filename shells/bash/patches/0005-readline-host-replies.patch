--- a/lib/readline/input.c
+++ b/lib/readline/input.c
@@ -182,6 +182,13 @@
 static unsigned char ibuffer[512];
 static int ibuffer_len = sizeof (ibuffer) - 1;
 
+/* Which bytes of the typeahead are text that Readline put back after it collected a bracketed
+   paste, to read it again as keys, and whether the byte `rl_get_char' took last was one.  A host's
+   answer is never among a paste's bytes, so a reader that tells the host's answers from the keys
+   a person presses leaves these alone. */
+static unsigned char ibuffer_pasted[sizeof (ibuffer)];
+static int kr_key_was_pasted;
+
 #define any_typein (push_index != pop_index)
 
 int
@@ -205,10 +212,33 @@
   int held = push_index - pop_index;
 
   if (held < 0)
-    held += ibuffer_len;
+    held += ibuffer_len + 1;
   return held;
 }
 
+/* The next byte already delivered, or -1 when there is none: the typeahead this reader holds
+   first, then the terminal's own queue, one byte at a time.  It never waits.  A reader that
+   would tell a host's answer to an application's question from the keys a person presses reads
+   ahead with it, and gives back with `_rl_unget_char' what it finds is not an answer. */
+int
+_rl_kr_delivered_byte (void)
+{
+  int key;
+  unsigned char c;
+
+  /* The text of a paste that Readline reads again is not an answer's, and no run is followed into
+     it. */
+  if (push_index != pop_index && ibuffer_pasted[pop_index])
+    return -1;
+  if (rl_get_char (&key))
+    return key;
+#if defined (FIONREAD)
+  if (_rl_nchars_available () > 0 && read (fileno (rl_instream), &c, sizeof (c)) == sizeof (c))
+    return c;
+#endif
+  return -1;
+}
+
 /* Return the amount of space available in the buffer for stuffing
    characters. */
 static int
@@ -227,8 +257,12 @@
 rl_get_char (int *key)
 {
   if (push_index == pop_index)
-    return (0);
+    {
+      kr_key_was_pasted = 0;
+      return (0);
+    }
 
+  kr_key_was_pasted = ibuffer_pasted[pop_index];
   *key = ibuffer[pop_index++];
 #if 0
   if (pop_index >= ibuffer_len)
@@ -252,11 +286,25 @@
       if (pop_index < 0)
 	pop_index = ibuffer_len;
       ibuffer[pop_index] = key;
+      /* A byte Readline gives back is the byte it took last, and stays what it was. */
+      ibuffer_pasted[pop_index] = kr_key_was_pasted;
       return (1);
     }
   return (0);
 }
 
+/* Stuff KEY into the front of the input buffer as a byte of pasted text that Readline will read
+   again as a key.  Returns non-zero if successful, zero if there is no space left in the
+   buffer. */
+int
+_rl_kr_unget_pasted_char (int key)
+{
+  if (_rl_unget_char (key) == 0)
+    return (0);
+  ibuffer_pasted[pop_index] = 1;
+  return (1);
+}
+
 /* If a character is available to be read, then read it and stuff it into
    IBUFFER.  Otherwise, just return.  Returns number of characters read
    (0 if none available) and -1 on error (EIO). */
@@ -404,8 +452,8 @@
    readline function wants to specify a timeout and not leave it up to
    the user, it should use _rl_input_queued(timeout_value_in_microseconds)
    instead. */
-int
-_rl_input_available (void)
+static int
+_rl_kr_tty_input_available (void)
 {
 #if defined (HAVE_PSELECT) || defined (HAVE_SELECT)
   fd_set readfds, exceptfds;
@@ -447,6 +495,55 @@
 #endif
 
   return 0;
+}
+
+/* The time now, from a clock that does not go backwards where there is one. */
+static void
+_rl_kr_now (struct timeval *now)
+{
+#if defined (HAVE_CLOCK_GETTIME) && defined (CLOCK_MONOTONIC)
+  struct timespec ts;
+
+  if (clock_gettime (CLOCK_MONOTONIC, &ts) == 0)
+    {
+      now->tv_sec = ts.tv_sec;
+      now->tv_usec = ts.tv_nsec / 1000;
+      return;
+    }
+#endif
+  gettimeofday (now, 0);
+}
+
+/* Is there input available to be read on the readline input file descriptor, once a host's
+   answer to a terminal query is left out?  A caller that asks first reads a key next and waits for
+   it, so a check must not report an answer as one: when the terminal's front byte begins an
+   answer that has been delivered whole, it is taken and dropped here, and the check asks again for
+   what is left of the time it was given, never more than that time.  Keys the person typed before
+   the answer are taken into the typeahead, which is input too. */
+int
+_rl_input_available (void)
+{
+  struct timeval began, now;
+  long used;
+  int r, timeout;
+
+  _rl_kr_now (&began);
+  r = _rl_kr_tty_input_available ();
+  while (r > 0 && rl_input_available_hook == 0 && _rl_pushed_input_available () == 0
+	 && kr_rl_drop_delivered_replies ())
+    {
+      if (_rl_pushed_input_available ())
+	return 1;
+      _rl_kr_now (&now);
+      used = (long)(now.tv_sec - began.tv_sec) * 1000000L + (long)(now.tv_usec - began.tv_usec);
+      if (used < 0)
+	used = 0;
+      timeout = _keyboard_input_timeout;
+      _keyboard_input_timeout = (used >= timeout) ? 0 : (int)(timeout - used);
+      r = _rl_kr_tty_input_available ();
+      _keyboard_input_timeout = timeout;
+    }
+  return r;
 }
 
 int
@@ -464,7 +561,9 @@
