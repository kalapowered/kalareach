--- a/lib/readline/input.c
+++ b/lib/readline/input.c
@@ -207,6 +207,25 @@
   if (held < 0)
     held += ibuffer_len;
   return held;
+}
+
+/* The next byte already delivered, or -1 when there is none: the typeahead this reader holds
+   first, then the terminal's own queue, one byte at a time.  It never waits.  A reader that
+   would tell a host's answer to an application's question from the keys a person presses reads
+   ahead with it, and gives back with `_rl_unget_char' what it finds is not an answer. */
+int
+_rl_kr_delivered_byte (void)
+{
+  int key;
+  unsigned char c;
+
+  if (rl_get_char (&key))
+    return key;
+#if defined (FIONREAD)
+  if (_rl_nchars_available () > 0 && read (fileno (rl_instream), &c, sizeof (c)) == sizeof (c))
+    return c;
+#endif
+  return -1;
 }
 
 /* Return the amount of space available in the buffer for stuffing
@@ -841,15 +860,21 @@
 	}
       else
 	{
-	  if (rl_get_char (&c) == 0)
+	  /* A host's answer to a terminal query is no key: when an Escape begins one, the reader
+	     takes the whole answer here and reads on. */
+	  do
 	    {
-	      c = (*rl_getc_function) (rl_instream);
-	      kr_rl_source (KR_SOURCE_TERMINAL);
+	      if (rl_get_char (&c) == 0)
+		{
+		  c = (*rl_getc_function) (rl_instream);
+		  kr_rl_source (KR_SOURCE_TERMINAL);
+		}
+	      else
+		kr_rl_source (KR_SOURCE_TYPEAHEAD);
+/* fprintf(stderr, "rl_read_key: calling RL_CHECK_SIGNALS: _rl_caught_signal = %d\r\n", _rl_caught_signal); */
+	      RL_CHECK_SIGNALS ();
 	    }
-	  else
-	    kr_rl_source (KR_SOURCE_TYPEAHEAD);
-/* fprintf(stderr, "rl_read_key: calling RL_CHECK_SIGNALS: _rl_caught_signal = %d\r\n", _rl_caught_signal); */
-	  RL_CHECK_SIGNALS ();
+	  while (c == ESC && kr_rl_host_reply_dropped ());
 	}
     }
 
