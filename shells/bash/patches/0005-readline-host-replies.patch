+
+/* The next byte already delivered, or -1 when there is none: the typeahead this reader holds
+   first, then the terminal's own queue, one byte at a time.  It never waits.  A reader that
+   would tell a host's answer to an application's question from the keys a person presses reads
+   ahead with it, and gives back with `_rl_unget_char' what it finds is not an answer. */
+int
+_rl_kr_delivered_byte (void)
+{
+  int key;
+  unsigned char c;
+
+  if (rl_get_char (&key))
+    return key;
+#if defined (FIONREAD)
+  if (_rl_nchars_available () > 0 && read (fileno (rl_instream), &c, sizeof (c)) == sizeof (c))
+    return c;
+#endif
+  return -1;
 }
 
 /* Return the amount of space available in the buffer for stuffing
@@ -404,8 +423,8 @@
    readline function wants to specify a timeout and not leave it up to
    the user, it should use _rl_input_queued(timeout_value_in_microseconds)
    instead. */
-int
-_rl_input_available (void)
+static int
+_rl_kr_tty_input_available (void)
 {
 #if defined (HAVE_PSELECT) || defined (HAVE_SELECT)
   fd_set readfds, exceptfds;
@@ -449,6 +468,36 @@
   return 0;
 }
 
+/* Is there input available to be read on the readline input file descriptor, once a host's
+   answer to a terminal query is left out?  A caller that asks first reads a key next and waits for
+   it, so a check must not report an answer as one: when the terminal's front byte begins an
+   answer that has been delivered whole, it is taken and dropped here, and the check asks again for
+   what is left of the time it was given.  Keys the person typed before the answer are taken into
+   the typeahead, which is input too. */
+int
+_rl_input_available (void)
+{
+  struct timeval began, now;
+  long used;
+  int r, timeout;
+
+  gettimeofday (&began, 0);
+  r = _rl_kr_tty_input_available ();
+  while (r > 0 && rl_input_available_hook == 0 && _rl_pushed_input_available () == 0
+	 && kr_rl_drop_delivered_replies ())
+    {
+      if (_rl_pushed_input_available ())
+	return 1;
+      gettimeofday (&now, 0);
+      used = (long)(now.tv_sec - began.tv_sec) * 1000000L + (long)(now.tv_usec - began.tv_usec);
+      timeout = _keyboard_input_timeout;
+      _keyboard_input_timeout = (used >= timeout) ? 0 : (int)(timeout - used);
+      r = _rl_kr_tty_input_available ();
+      _keyboard_input_timeout = timeout;
+    }
+  return r;
+}
+
