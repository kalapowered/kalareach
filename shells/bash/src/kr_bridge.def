$PRODUCES kr_bridge.c

$BUILTIN kr-bridge
$FUNCTION kr_bridge_builtin
$DOCNAME kr_bridge
$SHORT_DOC kr-bridge status|activated|lost [reason [detail]]
Report the state of the KalaReach root-editor integration.

The guarded startup entry uses this once, after the user's startup files have
run, to say that the integration's own hooks are live. Until it does, the
session is authenticated but not qualified.

    status      succeed when this shell registered a root integration
    activated   report that the user-facing hooks are live
    lost        report that the integration lost its hooks

Exit Status:
Succeeds unless this shell has no registered root integration or the request
is not one of the three above.
$END

#include <config.h>

#include <stdio.h>
#include <string.h>

#include "../bashtypes.h"
#include "../shell.h"

#include <readline/kr_bridge.h>
#include <readline/kr_bridge_rl.h>

#include "common.h"
#include "bashgetopt.h"

int
kr_bridge_builtin (list)
     WORD_LIST *list;
{
  char *request, *reason, *detail;
  int loss;

  if (list == 0)
    {
      builtin_usage ();
      return (EX_USAGE);
    }

  request = list->word->word;

  if (strcmp (request, "status") == 0)
    return (kr_bridge_registered () ? EXECUTION_SUCCESS : EXECUTION_FAILURE);

  if (strcmp (request, "activated") == 0)
    {
      if (kr_bridge_registered () == 0)
	return (EXECUTION_FAILURE);
      kr_bridge_hooks_activated (kr_rl_prompt_generation () + 1);
      return (EXECUTION_SUCCESS);
    }

  if (strcmp (request, "lost") == 0)
    {
      reason = list->next ? list->next->word->word : (char *)NULL;
      detail = (list->next && list->next->next) ? list->next->next->word->word : "";
      loss = KR_LOSS_SEMANTIC_HOOK_LOSS;
      if (reason && strcmp (reason, "post-startup-failure") == 0)
	loss = KR_LOSS_POST_STARTUP_FAILURE;
      else if (reason && strcmp (reason, "unqualified-root-replacement") == 0)
	loss = KR_LOSS_UNQUALIFIED_ROOT_REPLACEMENT;
      kr_bridge_lost (loss, detail);
      return (EXECUTION_SUCCESS);
    }

  builtin_usage ();
  return (EX_USAGE);
}
