     let envv = parser.vars().export_array();
 
     let actual_cmd = wcs2zstring(&p.actual_cmd);
+
+    // A command of the line the root shell runs itself asks the integration before it starts: it
+    // runs as it was typed, or through the launcher the answer names.
+    let kr_launch = match kr_bridge::asking(parser, j, p, proc_io_chain) {
+        kr_bridge::Asked::Launch(launch) => Some(launch),
+        kr_bridge::Asked::Stopped(status) => {
+            p.status.set(ProcStatus::from_exit_code(status));
+            return Err(());
+        }
+        kr_bridge::Asked::Not | kr_bridge::Asked::AsTyped => None,
+    };
 
     #[cfg(have_posix_spawn)]
     // Prefer to use posix_spawn, since it's faster on some systems like OS X.
-    if can_use_posix_spawn_for_job(j, &dup2s) {
+    if kr_launch.is_none() && can_use_posix_spawn_for_job(j, &dup2s) {
         let file = parser.current_filename.borrow();
         let count = FORK_COUNT.fetch_add(1, Ordering::Relaxed) + 1; // spawn counts as a fork+exec
 
@@ -934,6 +945,11 @@
     }
 
     fork_child_for_process(j, p, &dup2s, pgroup_policy, |p| {
+        if let Some(launch) = &kr_launch {
+            // Returns only when the launcher could not be started, and the command then runs as
+            // it was typed.
+            launch.exec();
+        }
         signal_safe_launch_process(p, &actual_cmd, &argv, &envv)
     })
 }
