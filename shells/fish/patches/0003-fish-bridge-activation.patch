+
+/// Compiles the KalaReach root-editor bridge's shell-independent core into the shell.
+///
+/// The reader's own half of the bridge is Rust, beside the reader it belongs to; the frames, the
+/// endpoint and every decision the contract states are the same C in every package, so they are
+/// the same source here as well.
+fn build_kr_bridge() {
+    let sources = [
+        "src/kr_bridge.c",
+        "src/kr_bridge_cbor.c",
+        "src/kr_bridge_crypto.c",
+    ];
+    fish_build_helper::rebuild_if_paths_changed(sources);
+    fish_build_helper::rebuild_if_paths_changed([
+        "src/kr_bridge.h",
+        "src/kr_bridge_cbor.h",
+        "src/kr_bridge_crypto.h",
+        "src/kr_bridge_identity.h",
+    ]);
+    cc::Build::new()
+        .files(sources)
+        .include("src")
+        // The same warning set the other packages compile this core with.
+        .extra_warnings(false)
+        .compile("kr_bridge");
 }
 
