+    /// The only other reader fish starts is the one the `read` builtin pushes, and it carries no
+    /// prompt event of its own.
+    pub(super) fn kr_is_primary(&self) -> bool {
+        self.conf.event == L!("fish_prompt")
+    }
+
+    /// The descriptor this reader reads from.
+    pub(super) fn kr_input_fd(&self) -> RawFd {
+        self.conf.inputfd
